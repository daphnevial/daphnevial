<section id="contacto" class="bento cols-3">
  <div class="card card-oscuro span-2 contacto-intro">
    <h2 class="titulo-contacto">¿Conversamos?</h2>
    <p>Estoy abierta a nuevas oportunidades como diseñadora UX/UI.</p>
  </div>
  <div class="contacto-links">
    <a class="card card-rojo contacto-link" href="mailto:{{ site.email }}">{{ site.email }} →</a>
    <a class="card contacto-link" href="{{ site.linkedin }}" target="_blank" rel="noopener">LinkedIn →</a>
    <a class="card contacto-link" href="{{ site.behance }}" target="_blank" rel="noopener">Behance →</a>
    <a class="card contacto-link" href="{{ site.cv }}" target="_blank" rel="noopener">Descargar CV →</a>
  </div>
</section>
