<section id="proyectos" class="seccion">
  <div class="seccion-cabecera">
    <h2 class="titulo">Proyectos</h2>
    <span class="muted">Haz clic en un proyecto para ver el caso de estudio</span>
  </div>
  <div class="bento cols-3">
    {% for p in casos %}
      {% set url = "/casos/" + p.slug + "/" %}
      {% if loop.first %}
      <a href="{{ url }}" class="card proyecto-principal card-{{ p.color }} span-2 row-2">
        <span class="badge badge-blanco">{{ p.etiqueta }}</span>
        <div class="imagen imagen-grande">{% if p.imagen %}<img src="{{ p.imagen }}" alt="{{ p.nombre }}">{% else %}[Imagen del proyecto]{% endif %}</div>
        <span class="proyecto-nombre-grande">{{ p.nombre }} →</span>
      </a>
      {% else %}
      <a href="{{ url }}" class="card proyecto card-{{ p.color }}">
        <div class="imagen imagen-chica">{% if p.imagen %}<img src="{{ p.imagen }}" alt="{{ p.nombre }}">{% else %}[Imagen]{% endif %}</div>
        <span class="proyecto-nombre">{{ p.nombre }} →</span>
      </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
