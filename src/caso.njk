---
layout: base.njk
pagination:
  data: casosPublicados
  size: 1
  alias: caso
permalink: "/casos/{{ caso.slug }}/"
eleventyComputed:
  title: "{{ caso.nombre }}"
---
{% set siguiente = casosPublicados[(pagination.pageNumber + 1) % (casosPublicados | length)] %}
<nav class="nav" aria-label="Principal">
  <a class="logo" href="/">Daphne Vial<span class="rojo">.</span></a>
  <a class="pill" href="/#proyectos">← Volver a proyectos</a>
</nav>

{% if caso.plantilla == "sia" %}
  {% include "casos/sia.njk" %}
{% else %}
  {% include "secciones/caso.njk" %}
{% endif %}

<nav class="cs-siguiente bento" aria-label="Más casos">
  <a class="card" href="/#proyectos">
    <span class="cs-mini">Volver</span>
    <span class="cs-siguiente-titulo">← Todos los proyectos</span>
  </a>
  {% if siguiente.slug != caso.slug %}
  <a class="card card-turquesa" href="/casos/{{ siguiente.slug }}/">
    <span class="cs-mini">Siguiente caso</span>
    <span class="cs-siguiente-titulo">{{ siguiente.nombre }} →</span>
  </a>
  {% endif %}
</nav>

{% include "secciones/pie.njk" %}
